{
	"compatibility_date": "2026-06-05",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "portal-kampus",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "database_kampus",
			"database_name": "database-kampus",
			"database_id": "1fa6113e-d511-48d2-af7c-d741ad732d9d"
		}
	]
}