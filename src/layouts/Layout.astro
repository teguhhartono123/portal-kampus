---
// 1. Kita import komponen Navbar yang baru saja Anda buat tadi
import Navbar from '../components/Navbar.astro';

interface Props {
  title?: string;
}

const { title = "Portal STIT YA'MAL" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />

    <meta name="viewport" content="width=device-width" />

    <!-- Inside src/layouts/Layout.astro <head> -->
    <!-- Add the "/" before favicon.ico and logo-kampus.png -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/logo-kampus.png" />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body style="margin: 0; padding: 0; background-color: #fcfcfc;">
    <!-- 2. Pasang komponen menu di paling atas tubuh halaman -->
    <Navbar />

    <!-- Slot ini adalah tempat otomatis wadah isi file index.astro dan galeri.astro -->
    <slot />
  </body>
</html>

<style is:global>
  html {
    /* Memaksa area scrollbar kanan selalu aktif di semua halaman */
    overflow-y: scroll;
  }
</style>
