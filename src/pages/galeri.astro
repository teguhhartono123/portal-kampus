---
import Layout from '../layouts/Layout.astro';
import { env } from 'cloudflare:workers';

interface FotoDatabase {
  id: number;
  url: string;
  deskripsi: string;
  tanggal_upload: string;
}

let daftarFoto: FotoDatabase[] = [];
let pesanError = "";

try {
  const db = env.database_campuses || env.database_kampus;

  if (!db) {
    throw new Error("Koneksi database 'database_kampus' tidak ditemukan! Pastikan nama binding di wrangler.jsonc sudah sesuai.");
  }

  const queryResult = await db.prepare("SELECT * FROM galeri_foto ORDER BY id DESC").all();
  daftarFoto = queryResult.results as unknown as FotoDatabase[];

} catch (error: any) {
  pesanError = `Gagal memuat database: ${error.message}`;
  console.error(pesanError);
  
  // Clean placeholder fallback content matching your real database seed layout
  daftarFoto = [
    { id: 1, url: "", deskripsi: "Kegiatan Rapat Akademik Jajaran Dosen STIT YA'MAL", tanggal_upload: "05 Juni 2026" },
    { id: 2, url: "", deskripsi: "Suasana Praktikum Mahasiswa di Ruang Laboratorium Komputer", tanggal_upload: "01 Juni 2026" },
    { id: 3, url: "", deskripsi: "Pelaksanaan Masa Orientasi Kampus (PROPESA) Mahasiswa Baru", tanggal_upload: "25 Mei 2026" },
    { id: 4, url: "", deskripsi: "Kegiatan Praktikum Pengalaman Lapangan Kependidikan (PPLK)", tanggal_upload: "20 Mei 2026" }
  ];
}
---

<Layout title="Galeri Foto - STIT YA'MAL">
  <main style="padding: 40px 20px; font-family: sans-serif; max-width: 950px; margin: 0 auto; display: flex; flex-direction: column; gap: 36px;">
    
    <!-- PAGE HEADER -->
    <div style="text-align: left; padding: 0 5px;">
      <h1 style="font-size: 2.6rem; font-weight: 800; color: #0f172a; margin-top: 0; margin-bottom: 12px; letter-spacing: -0.5px;">
        Galeri Dokumentasi Kampus
      </h1>
      <p style="color: #64748b; font-size: 1.15rem; line-height: 1.6; margin: 0;">
        Sistem penyimpanan arsip foto dokumentasi kegiatan akademik, agenda kemahasiswaan, dan perkembangan infrastruktur STIT YA'MAL Tangerang.
      </p>
    </div>

    <!-- MUTED SYSTEM STATUS LOG (Clean UI feedback) -->
    {pesanError && (
      <div style="padding: 14px 18px; background-color: #fff1f2; color: #b91c1c; border: 1px solid #fecdd3; border-radius: 12px; font-size: 0.9rem; font-weight: 500; display: flex; align-items: center; gap: 8px;">
        <span>⚠️</span> <span>Mode Cadangan Aktif: Hubungkan DB D1 di cloud console untuk sinkronisasi live.</span>
      </div>
    )}

    <!-- ADMIN UPLOAD AREA (Streamlined & Cleaned) -->
    <div style="background-color: #f8fafc; padding: 24px; border-radius: 16px; border: 2px dashed #cbd5e1; display: flex; flex-direction: column; gap: 14px;">
      <h3 style="margin: 0; color: #0f172a; font-size: 1.15rem; font-weight: 700;">Formulir Upload Arsip Foto Internal</h3>
      
      <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
        <input type="file" id="input-file-kampus" accept="image/*" style="font-size: 0.9rem; color: #475569;" />
        <button id="tombol-upload-kampus" style="padding: 10px 18px; background-color: #10b981; color: white; border: none; border-radius: 8px; font-weight: bold; font-size: 0.88rem; cursor: pointer; box-shadow: 0 4px 6px rgba(16,185,129,0.15);">
          🚀 Unggah ke Server
        </button>
      </div>
      <p id="status-upload" style="margin: 0; font-size: 0.9rem; font-weight: 600; color: #475569;"></p>
    </div>

    <!-- IMAGE GALLERY SYSTEM GRID -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
      {daftarFoto.map((foto) => (
        <div style="border: 1px solid #e2e8f0; border-radius: 16px; overflow: hidden; background-color: #ffffff; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02); display: flex; flex-direction: column;">
          
          <!-- IMAGE MEDIA HOLDER -->
          <div style="width: 100%; height: 190px; background-color: #f1f5f9; overflow: hidden; position: relative;">
            <img 
              src={foto.url && foto.url.trim() !== "" && foto.url !== "https://unsplash.com" && foto.url !== "https://picsum.photos" ? (foto.url.startsWith('data:') ? foto.url : `${foto.url}&t=${Date.now()}`) : "https://unsplash.com"} 
              alt={foto.deskripsi}
              style="width: 100%; height: 100%; object-fit: cover; display: block;"
              loading="lazy"
            />
          </div>

          <!-- Description Info Body -->
          <div style="padding: 20px; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between; gap: 12px;">
            <h3 style="margin: 0; font-size: 1.1rem; color: #0f172a; font-weight: 700; line-height: 1.5; letter-spacing: -0.2px;">
              {foto.deskripsi}
            </h3>
            
            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #f1f5f9; padding-top: 10px; margin-top: auto;">
              <span style="font-size: 0.8rem; color: #94a3b8; font-weight: 500;">
                REC ID: #{foto.id}
              </span>
              {foto.tanggal_upload && (
                <span style="font-size: 0.8rem; color: #64748b; font-weight: 500;">
                  📅 {foto.tanggal_upload}
                </span>
              )}
            </div>
          </div>
          
        </div>
      ))}
    </div>
  </main>
</Layout>
