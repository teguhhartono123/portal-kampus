---
// src/pages/galeri.astro - KODE UTUH SATU HALAMAN PENUH (DINAMIS & CLEAN)
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { env } from 'cloudflare:workers';

export const prerender = false;

interface FotoDatabase {
  id: number;
  url: string;
  deskripsi: string;
  tanggal_upload: string;
}

let daftarFoto: FotoDatabase[] = [];
let pesanError = "";

// 🚀 Deteksi pipa database cloud resmi
const db = env.database_campuses || env.database_kampus;

if (db) {
  try {
    const queryResult = await db.prepare("SELECT * FROM galeri_foto ORDER BY id DESC").all();
    daftarFoto = (queryResult.results as unknown as FotoDatabase[]) || [];
  } catch (error: any) {
    pesanError = `Gagal memuat database: ${error.message}`;
    console.error(error);
  }
} else {
  pesanError = "Koneksi pangkalan data 'database_kampus' tidak ditemukan!";
}
---

<Layout title="Galeri Foto - STIT YA'MAL">
  <main style="max-width: 1200px; margin: 0 auto; padding: 40px 20px; font-family: sans-serif; display: flex; flex-direction: column; gap: 32px;">
    
    <!-- 1. PAGE HEADER -->
    <div style="text-align: left;">
      <h1 style="font-size: 2.5rem; font-weight: 800; color: #0f172a; margin: 0 0 8px 0; letter-spacing: -0.5px;">
        Galeri Dokumentasi Kampus
      </h1>
      <p style="color: #64748b; font-size: 1.1rem; line-height: 1.6; margin: 0; max-width: 700px;">
        Sistem penyimpanan arsip foto dokumentasi kegiatan akademik, agenda kemahasiswaan, dan perkembangan infrastruktur STIT YA'MAL Tangerang.
      </p>
    </div>

    <!-- NOTIFIKASI ERROR JIKA DATA BERMASALAH -->
    {pesanError && (
      <div style="padding: 14px 18px; background-color: #fff1f2; color: #b91c1c; border: 1px solid #fecdd3; border-radius: 12px; font-size: 0.95rem; font-weight: 500;">
        ❌ {pesanError}
      </div>
    )}

    {daftarFoto.length === 0 && !pesanError && (
      <div style="padding: 40px; background-color: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 12px; text-align: center; color: #64748b; font-weight: 600; font-size: 1rem;">
        📸 Belum ada dokumentasi foto yang diunggah oleh admin kampus.
      </div>
    )}

    <!-- 2. IMAGE GALLERY SYSTEM GRID -->
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px;">
      {daftarFoto.map((foto) => (
        <div 
          class="galeri-card"
          onclick={`bukaLightbox('${foto.url}', '${foto.deskripsi.replace(/'/g, "\\'")}')`}
          style="background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 14px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02); cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; display: flex; flex-direction: column;"
        >
          <!-- Wadah Foto Crop Otomatis -->
          <div style="width: 100%; height: 220px; overflow: hidden; background-color: #f1f5f9; position: relative;">
            <img 
              src={foto.url} 
              alt={foto.deskripsi} 
              loading="lazy"
              style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s;" 
              onmouseover="this.style.transform='scale(1.05)'"
              onmouseout="this.style.transform='scale(1)'"
            />
          </div>
          <!-- Info Deskripsi Bawah -->
          <div style="padding: 18px; display: flex; flex-direction: column; gap: 12px; flex-grow: 1; justify-content: space-between;">
            <h3 style="font-size: 1.05rem; font-weight: 700; color: #0f172a; margin: 0; line-height: 1.5;">
              {foto.deskripsi}
            </h3>
            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #f1f5f9; padding-top: 10px; font-size: 0.8rem; color: #64748b; font-weight: 600;">
              <span style="background-color: #f1f5f9; padding: 4px 8px; border-radius: 6px;">ID: #{foto.id}</span>
              <span>📅 {foto.tanggal_upload || 'Baru'}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- 3. MODAL POP-UP LIGHTBOX (DETAIL MELAYANG) -->
    <div 
      id="lightboxModal" 
      onclick="tutupLightbox()"
      style="display: none; position: fixed; z-index: 9999; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(15, 23, 42, 0.9); align-items: center; justify-content: center; padding: 24px; box-sizing: border-box; backdrop-filter: blur(4px);"
    >
      <span style="position: absolute; top: 20px; right: 25px; color: #ffffff; font-size: 35px; font-weight: bold; cursor: pointer; user-select: none;">&times;</span>
      <div onclick="event.stopPropagation()" style="max-width: 900px; width: 100%; display: flex; flex-direction: column; gap: 16px;">
        <img id="lightboxImg" src="" style="max-height: 75vh; width: auto; max-width: 100%; border-radius: 12px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5); object-fit: contain; margin: 0 auto;" />
        <p id="lightboxCaption" style="color: #ffffff; text-align: center; font-size: 1.1rem; line-height: 1.6; margin: 0; font-weight: 600; text-shadow: 0 2px 4px rgba(0,0,0,0.5);"></p>
      </div>
    </div>

  </main>
  <Footer />
</Layout>

<script is:inline>
  function bukaLightbox(url, deskripsi) {
    const modal = document.getElementById("lightboxModal");
    const img = document.getElementById("lightboxImg");
    const caption = document.getElementById("lightboxCaption");
    
    if (modal && img && caption) {
      img.src = url;
      caption.textContent = deskripsi;
      modal.style.display = "flex";
      document.body.style.overflow = "hidden";
    }
  }

  function tutupLightbox() {
    const modal = document.getElementById("lightboxModal");
    if (modal) {
      modal.style.display = "none";
      document.body.style.overflow = "auto";
    }
  }

  document.addEventListener("keydown", function(e) {
    if (e.key === "Escape") tutupLightbox();
  });
</script>
