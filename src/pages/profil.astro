---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';


// Data Visi & Misi Kampus STIT YA'MAL
const visiMisi = {
  visi: 'Menjadi Sekolah Tinggi Ilmu Tarbiyah yang menghasilkan lulusan pendidik Islam yang profesional dan berakhlak berbasis nilai keislaman di wilayah Banten pada tahun 2030.',
  misi: [
    'Menyelenggarakan pendidikan dan pembelajaran yang terencana dan terstruktur untuk menghasilkan lulusan pendidik Islam yang profesional dan berakhlak.',
    'Mendorong pelaksanaan penelitian di bidang pendidikan Islam yang sederhana dan aplikatif oleh dosen dan mahasiswa.',
    'Melaksanakan pengabdian kepada masyarakat melalui kegiatan pendidikan, dakwah, dan pemberdayaan umat.',
    'Mengembangkan kerjasama dengan sekolah, madrasah, dan lembaga pendidikan di wilayah Banten.',
    'Menyelenggarakan layanan akademik yang efektif, sederhana, dan responsif bagi mahasiswa.',
  ],
};
---

<Layout title="Profil Institusi - STIT YA'MAL">
  <main style="padding: 40px 20px; font-family: sans-serif; max-width: 850px; margin: 0 auto;">
    
    <!-- Bagian Judul Utama (Lebih Kokoh dengan Slate 900 & 500) -->
    <div style="text-align: left; margin-bottom: 40px; padding: 0 5px;">
      <h1 style="font-size: 2.6rem; font-weight: 800; color: #0f172a; margin-top: 0; margin-bottom: 12px; letter-spacing: -0.5px;">
        Profil STIT YA'MAL Tangerang
      </h1>
      <p style="color: #64748b; font-size: 1.15rem; line-height: 1.6; font-weight: 400; margin: 0;">
        Mengenal lebih dekat Sekolah Tinggi Ilmu Tarbiyah (STIT) YA'MAL Tangerang sebagai pencetak generasi pendidik Islam yang unggul, berintegritas, dan berkarakter mulia.
      </p>
    </div>

    <!-- WRAPPER KOTAK KONTEN (Menggunakan Flexbox Gap agar Jarak Konsisten) -->
    <div style="display: flex; flex-direction: column; gap: 32px;">

      <!-- KOTAK SEJARAH SINGKAT -->
      <section style="padding: 32px; border: 1px solid #e2e8f0; border-radius: 16px; background-color: #ffffff; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02); margin: 0;">
        <h2 style="font-size: 1.4rem; color: #0f172a; font-weight: 700; margin-top: 0; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
          <span>📜</span> Sejarah Singkat
        </h2>
        <p style="color: #334155; line-height: 1.75; font-size: 1rem; margin-bottom: 16px; font-weight: 400;">
          Sekolah Tinggi Ilmu Tarbiyah (STIT) YA'MAL Tangerang didirikan di bawah naungan Yayasan Pendidikan Islam (YPI) Ya'mal sebagai bentuk respon nyata terhadap tingginya kebutuhan guru agama Islam profesional yang memiliki kompetensi pedagogic mutakhir serta fondasi akhlak yang kokoh.
        </p>
        <p style="color: #334155; line-height: 1.75; font-size: 1rem; margin: 0; font-weight: 400;">
          Sejak awal berdiri, STIT YA'MAL terus berkomitmen untuk menyelenggarakan tridharma perguruan tinggi secara konsisten guna mencetak sarjana pendidikan (S.Pd.) yang siap berkontribusi memajukan dunia pendidikan di wilayah Tangerang, Banten, dan kancah nasional.
        </p>
      </section>

      <!-- KOTAK VISI & MISI -->
      <section style="padding: 32px; border: 1px solid #e2e8f0; border-radius: 16px; background-color: #ffffff; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02); margin: 0;">
        <h2 style="font-size: 1.4rem; color: #0f172a; font-weight: 700; margin-top: 0; margin-bottom: 24px; display: flex; align-items: center; gap: 10px;">
          <span>🎯</span> Visi & Misi
        </h2>

        <!-- Blok Visi Kampus -->
        <div style="margin-bottom: 28px;">
          <h4 style="margin: 0 0 10px 0; color: #0d9488; font-size: 1rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">
            Visi Institusi
          </h4>
          <blockquote style="color: #1e293b; line-height: 1.7; font-size: 1.05rem; font-style: italic; background-color: #f8fafc; padding: 20px; border-left: 4px solid #0d9488; margin: 0; border-radius: 0 12px 12px 0; font-weight: 500;">
            "{visiMisi.visi}"
          </blockquote>
        </div>

        <!-- Blok Misi Kampus -->
        <div>
          <h4 style="margin: 0 0 14px 0; color: #0d9488; font-size: 1rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">
            Misi Institusi
          </h4>
          <ol style="color: #334155; line-height: 1.75; font-size: 1rem; padding-left: 20px; margin: 0; display: flex; flex-direction: column; gap: 12px;">
            {visiMisi.misi.map((misiText) => (
              <li style="margin-0; padding-left: 4px;">{misiText}</li>
            ))}
          </ol>
        </div>
      </section>

      <!-- KOTAK PROGRAM STUDI -->
      <section style="padding: 32px; border: 1px solid #e2e8f0; border-radius: 16px; background-color: #ffffff; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02); margin: 0;">
        <h2 style="font-size: 1.4rem; color: #0f172a; font-weight: 700; margin-top: 0; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
          <span>🎓</span> Program Studi Unggulan
        </h2>
        
        <div style="display: flex; gap: 20px; align-items: flex-start; padding: 24px; background-color: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 12px; box-shadow: 0 2px 4px rgba(22,163,74,0.02);">
          <span style="font-size: 2.2rem; line-height: 1; margin-top: 2px;">📄</span>
          <div>
            <h4 style="margin: 0 0 8px 0; color: #166534; font-size: 1.2rem; font-weight: 800; letter-spacing: -0.3px;">
              S1 - Pendidikan Agama Islam (PAI)
            </h4>
            <p style="margin: 0; color: #14532d; font-size: 0.95rem; line-height: 1.6; font-weight: 400;">
              Menjadi Program Studi Pendidikan Agama Islam yang menghasilkan lulusan pendidik Islam yang profesional dan berakhlak di wilayah Banten pada tahun 2030.
            </p>
          </div>
        </div>
      </section>

    </div>
  </main>
  <Footer />
</Layout>
