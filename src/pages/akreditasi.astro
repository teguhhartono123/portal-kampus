---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Akreditasi - STIT YA'MAL">
  <main style="padding: 40px 20px; font-family: sans-serif; max-width: 800px; margin: 0 auto;">
    <h1 style="font-size: 2.5rem; color: #111827;">Akreditasi Institusi BAN-PT</h1>
    <p style="color: #475569; line-height: 1.7; font-size: 1.1rem;">
      Seluruh program studi di Sekolah Tinggi Ilmu Tarbiyah (STIT) YA'MAL Tangerang telah resmi terakreditasi oleh Badan Akreditasi Nasional Perguruan Tinggi (BAN-PT), menjamin mutu kurikulum dan legalitas lulusan di dunia kerja.
    </p>
  </main>
</Layout>
