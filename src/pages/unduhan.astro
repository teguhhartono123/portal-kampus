---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Unduhan Berkas - STIT YA'MAL">
  <main style="padding: 40px 20px; font-family: sans-serif; max-width: 900px; margin: 0 auto;">
    <h1 style="font-size: 2.5rem; color: #111827;">Pusat Unduhan Berkas</h1>
    <p style="color: #475569; line-height: 1.7; font-size: 1.1rem;">
      Halaman ini menyediakan berkas akademik penting yang bisa diunduh oleh mahasiswa, seperti Kalender Akademik, Formulir Pengajuan Skripsi, Dokumen Panduan PPLK, dan Berkas Administrasi Beasiswa.
    </p>
  </main>
</Layout>
