---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { env } from 'cloudflare:workers';

export const prerender = false;

let daftarMatakuliah: any[] = [];

// 📡 PIPELINE D1 SAKLAR ASTRO v5 SULTAN (Membaca murni via import cloudflare:workers - KEBAL ERROR 500)
const db = env.DB || env.database_campuses || env.database_kampus;

if (db) {
  try {
    const { results } = await db.prepare("SELECT * FROM kurikulum_obe ORDER BY semester ASC, kode_mk ASC").all();
    daftarMatakuliah = results || [];
  } catch (err: any) {
    console.error("Gagal membaca database D1 kurikulum depan:", err.message);
  }
}

// 🧠 AGGREGATION ENGINE 1: Hitung otomatis Total SKS dan persentase kelompok secara DYNAMIC LIVE dari database!
const rekapKelompokSKS: Record<string, number> = {};

daftarMatakuliah.forEach((item: any) => {
  // Langsung sedot teks kalimat kelompok apa adanya dari kolom kelompok database D1 bapak
  const kat = item.kelompok || 'Wajib Program Studi';
  
  // Jika nama kelompok baru tersebut belum ada kamarnya di mesin hitung, auto-buat kamarnya!
  if (!rekapKelompokSKS.hasOwnProperty(kat)) {
    rekapKelompokSKS[kat] = 0;
  }
  
  // Akumulasikan bobot kredit SKS secara live dynamic real-time
  rekapKelompokSKS[kat] += Number(item.sks || 0);
});

const totalSemuaSKS = Object.values(rekapKelompokSKS).reduce((a, b) => a + b, 0);

// 🚨 TETAP DIPAKAI SULTAN: Penggerak utama loop sebaran boks kartu semester di HTML bawah!
const listSemester = ['Semester I', 'Semester II', 'Semester III', 'Semester IV', 'Semester V', 'Semester VI', 'Semester VII', 'Semester VIII'];
---


<Layout title="Kurikulum Berbasis OBE - STIT YA'MAL">
  <main style="padding: 40px 20px; font-family: sans-serif; max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; gap: 40px;">
    
    <!-- 📄 SEKTOR LOTENG: JUDUL UTAMA PUBLIK -->
    <div style="text-align: left; padding: 0 5px;">
      <h1 style="font-size: 2.5rem; font-weight: 800; color: #0f172a; margin: 0 0 12px 0; letter-spacing: -0.5px;">
        Kurikulum Berbasis OBE
      </h1>
      <p style="color: #64748b; font-size: 1.1rem; line-height: 1.6; font-weight: 400; margin: 0;">
        Struktur sebaran beban Satuan Kredit Semester (SKS) kurikulum nasional rumpun keilmuan Tarbiyah S1 Pendidikan Agama Islam (PAI) STIT YA'MAL.
      </p>
    </div>

    <!-- 📊 CONTAINER UTAMA SEBARAN SEMESTER DYNAMIC LOOP -->
    <div style="display: flex; flex-direction: column; gap: 32px;">
      
      {listSemester.map((sem) => {
        // Filter matakuliah khusus semester ini saja
        const mkSemesterIni = daftarMatakuliah.filter(item => item.semester === sem);
        
        // 🧠 AGGREGATION ENGINE 2: Hitung total SKS live khusus semester ini
        const totalSKSSemester = mkSemesterIni.reduce((acc, curr) => acc + Number(curr.sks || 0), 0);

        return (
          <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.01);">
            <div style="background-color: #f8fafc; padding: 16px 24px; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
              <h3 style="margin: 0; font-size: 1.15rem; color: #0f172a; font-weight: 800;">{sem}</h3>
              <span style="font-size: 0.8rem; background-color: #e0f2fe; color: #0369a1; padding: 4px 10px; border-radius: 6px; font-weight: 700;">Total: {totalSKSSemester} SKS</span>
            </div>
            <div style="overflow-x: auto; padding: 12px 24px 24px 24px;">
              <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.92rem;">
                <thead>
                  <tr style="border-bottom: 2px solid #f1f5f9; color: #475569; font-weight: bold;">
                    <th style="padding: 12px 8px; width: 8%; text-align: center;">No</th>
                    <th style="padding: 12px 8px; width: 18%;">Kode</th>
                    <th style="padding: 12px 8px; width: 44%;">Mata Kuliah</th>
                    <th style="padding: 12px 8px; text-align: center; width: 10%;">SKS</th>
                    <th style="padding: 12px 8px; text-align: center; width: 22%;">Download</th>
                  </tr>
                </thead>
                <tbody>
                  {mkSemesterIni.length === 0 ? (
                    <tr>
                      <td colspan="5" style="padding: 16px 8px; text-align: center; color: #94a3b8; font-style: italic;">Belum ada data mata kuliah untuk {sem}.</td>
                    </tr>
                  ) : (
                    mkSemesterIni.map((row, index) => (
                      <tr style="border-bottom: 1px solid #f8fafc;" onmouseover="this.style.backgroundColor='#f8fafc'" onmouseout="this.style.backgroundColor='transparent'">
                        <td style="padding: 14px 8px; text-align: center; color: #64748b; font-weight: 600;">{index + 1}</td>
                        <td style="padding: 14px 8px; font-family: monospace; font-weight: bold; color: #4f46e5;">{row.kode_mk}</td>
                        <td style="padding: 14px 8px; color: #0f172a; font-weight: 600; line-height: 1.4;">{row.nama_mk}</td>
                        <td style="padding: 14px 8px; text-align: center; font-weight: bold;">{row.sks} SKS</td>
                        <td style="padding: 14px 8px; text-align: center;">
                          <div style="display: inline-flex; gap: 6px; justify-content: center; width: 100%;">
                            <a href={row.rps_url || '#'} target={row.rps_url && row.rps_url !== '#' ? '_blank' : '_self'} style="text-decoration: none; font-size: 0.72rem; font-weight: 700; color: #dc2626; background: #fef2f2; padding: 4px 8px; border-radius: 6px;">RPS</a>
                            <a href={row.silabus_url || '#'} target={row.silabus_url && row.silabus_url !== '#' ? '_blank' : '_self'} style="text-decoration: none; font-size: 0.72rem; font-weight: 700; color: #dc2626; background: #fef2f2; padding: 4px 8px; border-radius: 6px;">Silabus</a>
                          </div>
                        </td>
                      </tr>
                    ))
                  )}
                </tbody>
              </table>
            </div>
          </div>
        );
      })}

    </div> <!-- Penutup Tag Kontainer Utama Sebaran Semester -->

    <!-- 📌 SEKTOR CATATAN KAKI PILIHAN PRODI (UMSU STYLE) -->
    <div style="background-color: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 12px; padding: 18px 24px; display: flex; gap: 14px; align-items: flex-start; margin-top: -8px;">
      <span style="font-size: 1.2rem; margin-top: -2px;">*</span>
      <p style="margin: 0; color: #475569; font-size: 0.92rem; line-height: 1.6; font-weight: 500;">
        Mata kuliah pilihan program studi sebanyak 12 SKS, mahasiswa wajib mengambil 6 SKS sesuai pilihan yang diambil.
      </p>
    </div>

    <!-- ========================================================================= -->
    <!-- 📊 SEKTOR RINCIAN REKAPITULASI DYNAMIC TOTALAN SKS HALAMAN DEPAN         -->
    <!-- ========================================================================= -->
    <section style="margin-top: 10px; display: flex; flex-direction: column; gap: 18px;">
      <div style="padding: 0 5px;">
        <h2 style="font-size: 1.25rem; color: #0f172a; font-weight: 800; margin: 0; letter-spacing: -0.3px;">
          Rincian Mata Kuliah Program Studi Pendidikan Agama Islam STIT YA'MAL
        </h2>
      </div>

      <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.01); padding: 12px 24px 24px 24px;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.94rem;">
          <thead>
            <tr style="border-bottom: 2px solid #f1f5f9; color: #475569; font-weight: bold;">
              <th style="padding: 14px 8px; width: 10%; text-align: center;">No</th>
              <th style="padding: 14px 8px; width: 55%;">Kelompok Mata Kuliah</th>
              <th style="padding: 14px 8px; text-align: center; width: 18%;">SKS</th>
              <th style="padding: 14px 8px; text-align: center; width: 17%;">%</th>
            </tr>
          </thead>
          <tbody>
            {Object.entries(rekapKelompokSKS).map(([kelompok, jumlahSKS], index) => {
              const persen = totalSemuaSKS > 0 ? ((jumlahSKS / totalSemuaSKS) * 100).toFixed(0) : '0';
              return (
                <tr style="border-bottom: 1px solid #f8fafc;">
                  <td style="padding: 14px 8px; text-align: center; color: #64748b; font-weight: 600;">{index + 1}</td>
                  <td style="padding: 14px 8px; color: #334155; font-weight: 600;">{kelompok}</td>
                  <td style="padding: 14px 8px; text-align: center; font-weight: bold; color: #0f172a;">{jumlahSKS}</td>
                  <td style="padding: 14px 8px; text-align: center; color: #475569; font-weight: 500;">{persen}</td>
                </tr>
              );
            })}
            {/* 📊 TOTAL BARIS AKHIR REAL-TIME COUNTER */}
            <tr style="background-color: #f8fafc; font-weight: bold;">
              <td style="padding: 16px 8px;"></td>
              <td style="padding: 16px 8px; color: #0f172a; text-align: center; font-weight: 800; font-size: 1rem;">Jumlah</td>
              <td style="padding: 16px 8px; text-align: center; color: #4f46e5; font-weight: 800; font-size: 1rem;">{totalSemuaSKS}</td>
              <td style="padding: 16px 8px; text-align: center; color: #0f172a; font-weight: 800; font-size: 1rem;">{totalSemuaSKS > 0 ? '100' : '0'}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

  </main> <!-- Penutup Tag Main Body Layout -->
  <Footer /> <!-- 🏛️ Komponen Kaki Web STIT YA'MAL -->
</Layout> <!-- Penutup Tag Master Template Layout Astro -->
