// src/pages/admin/dashboard.astro - LOGIKA BACKEND CMS SATU PINTU (CLEAN WORKSPACE)
import Layout from '../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';

export const prerender = false;
const { request } = Astro;

let statusPesan = "";
let tipePesan = ""; 
let infoBrosur = null;

let pengumumanRows: any[] = [];
let unduhanRows: any[] = [];
let jurnalRows: any[] = [];
let listGaleri: any[] = [];
let daftarPengumuman: any[] = [];
let daftarBrosurAdmin: any[] = [];

const db = env.database_campuses || env.database_kampus;

// 🔐 SECURITY GATE: VALIDASI COOKIE ADMIN
const tokenSesi = Astro.cookies.get("admin_session")?.value;
const sessionKV = env.SESSION;
let adminTervalidasi = false;

if (db) {
  try {
    // 🟢 SENSOR MONITORING ADMIN: Ambil murni 1 data teranyar dari database untuk ditampilkan di dashboard bapak!
    const queryBrosurAdmin = await db.prepare("SELECT * FROM konfigurasi_brosur ORDER BY id DESC LIMIT 1;").first();
    infoBrosur = queryBrosurAdmin || null;
    
    // Suapkan ke dalam array biar Tabel Kelola bawah Abang langsung mekar sinkron terisi!
    if (queryBrosurAdmin) {
      daftarBrosurAdmin = [queryBrosurAdmin];
    }
  } catch (error) {
    console.error("Gagal membaca status monitoring brosur teranyar:", error);
  }
}

if (tokenSesi && sessionKV) {
  const dataSesi = await sessionKV.get(tokenSesi);
  if (dataSesi) {
    adminTervalidasi = true;
  }
}

if (!adminTervalidasi) {
  return Astro.redirect("/admin");
}

// 🏛️ MAIN FORM ACTIONS HANDLER (POST REQUEST)
if (request.method === "POST") {
  try {
    if (!db) throw new Error("Koneksi database_kampus tidak ditemukan.");
    
    const formData = await request.formData();
    // Gunakan form_type sebagai satu-satunya penentu aksi formulir
    const formType = formData.get("form_type")?.toString();

    // ========================================================
    // 📸 KELOMPOK 1: MANAJEMEN UPLOAD BINARY FILE GALERI FOTO
    // ========================================================
    if (formType === "upload_file_galeri") {
      const berkasFoto = formData.get("berkas_foto") as File;
      const deskripsiFoto = formData.get("deskripsi_foto")?.toString();

      if (berkasFoto && berkasFoto.size > 0 && deskripsiFoto) {
        const arrayBuffer = await berkasFoto.arrayBuffer();
        const base64Data = Buffer.from(arrayBuffer).toString('base64');
        const mimeType = berkasFoto.type;
        const directUrlData = `data:${mimeType};base64,${base64Data}`;

        await db.prepare("INSERT INTO galeri_foto (url, deskripsi) VALUES (?, ?)").bind(directUrlData, deskripsiFoto).run();
        statusPesan = "🚀 Berkas foto asli sukses diunggah langsung ke database D1 lokal!";
        tipePesan = "sukses";
      }
    }

    // Aksi hapus galeri foto
    if (formType === "hapus_galeri") {
      const hapusFotoId = formData.get("hapus_foto_id")?.toString();
      if (hapusFotoId) {
        await db.prepare("DELETE FROM galeri_foto WHERE id = ?").bind(parseInt(hapusFotoId)).run();
        statusPesan = "🗑️ Foto dokumentasi berhasil dihapus dari server cloud!";
        tipePesan = "sukses";
      }
    }

    // ========================================================
    // 📝 KELOMPOK 2: MANAJEMEN DATA LAMA (PENGUMUMAN, UNDUHAN, JURNAL)
    // ========================================================

    // 1. Tambah Pengumuman
    if (formType === "tambah_pengumuman") {
      const judul = formData.get("judul_pengumuman")?.toString();
      const tipe = formData.get("tipe_pengumuman")?.toString();
      if (judul && tipe) {
        await db.prepare("INSERT INTO daftar_pengumuman (judul, tanggal, tipe) VALUES (?, '07 Juni 2026', ?)").bind(judul, tipe).run();
        statusPesan = "🚀 New Announcement published successfully!";
        tipePesan = "sukses";
      }
    }

    // 2. Hapus Pengumuman
    if (formType === "hapus_pengumuman") {
      const idHapus = formData.get("id_pengumuman")?.toString();
      if (idHapus) {
        await db.prepare("DELETE FROM daftar_pengumuman WHERE id = ?").bind(idHapus).run();
        statusPesan = "Announcement record deleted successfully!";
        tipePesan = "sukses";
      }
    }

    // 3. Tambah Unduhan Dokumen (UPGRADE TOTAL: BISA UPLOAD FILE ASLI BINARY)
    if (formType === "tambah_unduhan") {
      const nama = formData.get("nama_file")?.toString();
      const kat = formData.get("kategori_file")?.toString();
      const fmt = formData.get("format_file")?.toString();
      const size = formData.get("ukuran_file")?.toString();
      // Ambil berkas file biner (.pdf/.docx) asli dari browser
      const berkasFile = formData.get("berkas_file") as File;

      if (nama && kat && fmt && size && berkasFile && berkasFile.size > 0) {
        // 🟢 SURAT AKTA KELAHIRAN MIMETYPE RESMI: Sesuai dengan nama variabel berkasFile milik Abang!
        const mimeType = berkasFile.type || "application/pdf";

        const buffer = Buffer.from(await berkasFile.arrayBuffer());
        // 🧠 Variabel directUrlData bapak sekarang otomatis membaca mimeType dinamis dengan aman!
        const directUrlData = `data:${mimeType};base64,${buffer.toString("base64")}`;

        await db.prepare("INSERT INTO daftar_unduhan (nama, kategori, format, ukuran, download_url) VALUES (?, ?, ?, ?, ?)").bind(nama, kat, fmt, size, directUrlData).run();
        statusPesan = "📂 Berkas dokumen kampus sukses diunggah langsung ke database D1 lokal!";
        tipePesan = "sukses";
      }
    }


    // 4. Hapus Unduhan Dokumen
    if (formType === "hapus_unduhan") {
      const idHapus = formData.get("id_unduhan")?.toString();
      if (idHapus) {
        await db.prepare("DELETE FROM daftar_unduhan WHERE id = ?").bind(idHapus).run();
        statusPesan = "Download asset record removed from D1!";
        tipePesan = "sukses";
      }
    }

    // 5. Tambah Index Jurnal Ilmiah
    if (formType === "tambah_jurnal") {
      const judul = formData.get("judul_jurnal")?.toString();
      const penulis = formData.get("penulis_jurnal")?.toString();
      const vol = formData.get("volume_jurnal")?.toString();    // 🌟 SUDAH FIX JADI 'vol'
      const status = formData.get("status_jurnal")?.toString();
      const pdf_url = formData.get("url_jurnal")?.toString();   // 🌟 SUDAH FIX JADI 'pdf_url'
      
      if (judul && penulis && vol && status && pdf_url) {
        await db.prepare("INSERT INTO daftar_jurnal (judul, penulis, vol, status, pdf_url) VALUES (?, ?, ?, ?, ?)")
                .bind(judul, penulis, vol, status, pdf_url).run();
                
        statusPesan = "📚 Research journal record indexed successfully to university database!";
        tipePesan = "sukses";
      }
    }


    // 6. Hapus Index Jurnal Ilmiah
    if (formType === "hapus_jurnal") {
      const idHapus = formData.get("id_jurnal")?.toString();
      if (idHapus) {
        await db.prepare("DELETE FROM daftar_jurnal WHERE id = ?").bind(parseInt(idHapus)).run();
        statusPesan = "Journal index entry removed successfully!";
        tipePesan = "sukses";
      }
    }

 
    // 7 Tambah Brosur
    if (formType === "update_brosur_pmb") {
      const berkasUtama = formData.get("berkas_brosur_utama") as File;
      const labelBrosur = formData.get("label_brosur_pmb")?.toString();

      if (berkasUtama && berkasUtama.size > 0 && labelBrosur) {
        
        // 1. Ekstrak nama ekstensi file asli
        const namaFileAsli = berkasUtama.name;
        const ekstensiBersih = (namaFileAsli.split('.').pop() || 'PDF').toUpperCase();

        // 2. Proses File Utama ke Base64 Data URL (Hanya lakukan ini SEKALI saja)
        const utamaBuffer = await berkasUtama.arrayBuffer();
        const utamaBase64 = Buffer.from(utamaBuffer).toString('base64');
        const urlFileUtama = `data:${berkasUtama.type || "application/octet-stream"};base64,${utamaBase64}`;

        // 3. LOGIKA ANTI-DOUBLING: Isi kolom cover dengan teks referensi saja, bukan file biner!
        let referensiCover = "";
        if (ekstensiBersih === "PDF") {
          referensiCover = "DEFAULT_PDF_TEMPLATE"; // Penanda untuk menggunakan gambar template PDF
        } else {
          referensiCover = "USE_PRIMARY_FILE"; // Penanda agar mengambil langsung dari kolom url_file
        }

        // 4. Kalkulasi ukuran kapasitas file otomatis
        const ukuranMB = `${(berkasUtama.size / (1024 * 1024)).toFixed(2)} MB`;

        // 🟢 PIPELINE 1 (AUTOINCREMENT MULTI-ROW): Menyimpan data terus ke bawah sebagai rekor baru abadi!
        await db.prepare("INSERT INTO konfigurasi_brosur (label, url_file, url_cover, format, ukuran) VALUES (?, ?, ?, ?, ?)")
                .bind(labelBrosur, urlFileUtama, "", ekstensiBersih, ukuranMB)
                .run();

        // 🟢 PIPELINE 2 (CHAINING SAKRAL): Salin otomatis rekornya ke gudang arsip massal halaman luar unduhan bapak!
        await db.prepare("INSERT INTO daftar_unduhan (nama, kategori, format, ukuran, download_url) VALUES (?, 'Brosur', ?, ?, ?)")
                .bind(labelBrosur, ekstensiBersih, ukuranMB, urlFileUtama)
                .run();

        statusPesan = "✔ Sukses! Brosur Baru resmi ditambahkan ke dalam database sistem.";
        tipePesan = "sukses";

      }
    }

    // =========================================================================
    // 🗑️ KABEL BACKEND BARU: EKSEKUSI HAPUS / RESET ASSET BROSUR UTAMA (D1)
    // =========================================================================
    if (formType === "hapus_brosur_pmb") {
      const idBrosur = formData.get("id_brosur")?.toString();
      
      if (idBrosur && db) {
        try {
          const dataBrosurLama = await db.prepare("SELECT label FROM konfigurasi_brosur WHERE id = ?;").bind(idBrosur).first();

          if (dataBrosurLama && dataBrosurLama.label){
            const potonganJudul = dataBrosurLama.label.substring(0, 20);
            const kataKunciParsial = "%" + potonganJudul + "%";
            await db.prepare("DELETE FROM daftar_unduhan WHERE nama LIKE ? AND (kategori LIKE 'brosur' OR kategori LIKE 'BROSUR');").bind(kataKunciParsial).run();
          }

        // Hapus rekor data brosur berdasarkan ID dari kamar database D1
        await db.prepare("DELETE FROM konfigurasi_brosur WHERE id = ?").bind(idBrosur).run();
        statusPesan = "🗑️ Brochure removed successfully!";
        tipePesan = "sukses";
        
        }
        catch(errInner){
          console.error("Gagal menjalankan cascade delete internal:", errInner);
        }
      }
    }


//============= catch error ini milik global db. JADI JANGAN DI OTAK ATIK
  } catch (error: any) {
    statusPesan = `❌ Database Action Failed: ${error.message}`;
    tipePesan = "gagal";
  }
}


// ========================================================
// 3. DYNAMIC READ FETCHES (TARIK DATA REKOR UNTUK RENDER TABEL)
// ========================================================


if (db) {
  try {
    const fetchP = await db.prepare("SELECT * FROM daftar_pengumuman ORDER BY id DESC").all();
    pengumumanRows = fetchP.results || [];

    const fetchU = await db.prepare("SELECT * FROM daftar_unduhan WHERE kategori != 'Brosur' ORDER BY id DESC").all();
    unduhanRows = fetchU.results || [];

    const fetchG = await db.prepare("SELECT * FROM galeri_foto ORDER BY id DESC").all();
    listGaleri = fetchG.results || [];

    const fetchJ = await db.prepare("SELECT * FROM daftar_jurnal ORDER BY id DESC").all();
    jurnalRows = fetchJ.results || [];

    // 🌟 KABEL UTAMA: Tarik data berkas dari D1, lalu suapkan murni ke mangkok default atas!
    const fetchBrosur = await db.prepare("SELECT * FROM konfigurasi_brosur ORDER BY id DESC").all();
    daftarBrosurAdmin = fetchBrosur.results || [];


  } catch (err: any) {
    console.error("Gagal membaca baris database:", err.message);
  }
}
