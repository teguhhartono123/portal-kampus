              {infoBrosur?.label || "Brosur Utama Pendaftaran Mahasiswa Baru 2026/2027"}
            </h3>
          </div>

          {/* Dual Action Buttons Split Layout (Kebal Anti-Null) */}
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
            <a 
              href="#"
              onclick={`
                event.preventDefault();
                const base64Data = "${infoBrosur?.url_file || '/images/brosur-pmb2026.webp'}";
                if (base64Data.startsWith('/')) {
                  window.open(base64Data, '_blank');
                } else {
                  const win = window.open();
                  win.document.write('<html><head><title>Pratinjau Brosur</title><style>body{margin:0;background:#0e1117;display:flex;justify-content:center;align-items:center;min-height:100vh;}img{max-width:95%;max-height:95vh;box-shadow:0 10px 25px rgba(0,0,0,0.5);border-radius:8px;}</style></head><body><img src="' + base64Data + '" /></body></html>');
                  win.document.close();
                }
              `}
              style="text-decoration: none; border: 1px solid #cbd5e1; color: #334155; padding: 10px 12px; border-radius: 6px; font-weight: 600; font-size: 0.75rem; text-align: center; background-color: #ffffff; transition: all 0.15s;"
              onMouseOver={(e) => e.currentTarget.style.backgroundColor = '#f8fafc'}
              onMouseOut={(e) => e.currentTarget.style.backgroundColor = '#ffffff'}
            >
              Pratinjau
            </a>
            
            <a 
              href={infoBrosur?.url_file || "/images/brosur-pmb2026.webp"} 
              download={infoBrosur?.label ? `${infoBrosur.label.trim().replace(/[^a-zA-Z0-9]/g, "_")}.${infoBrosur?.format?.toLowerCase() || 'webp'}` : "Brosur_Utama_STIT_Yamal_2026.webp"} 
              style="text-decoration: none; background-color: #16a34a; color: white; padding: 10px 12px; border-radius: 6px; font-weight: 600; font-size: 0.75rem; text-align: center; transition: background-color 0.15s;"
              onMouseOver={(e) => e.currentTarget.style.backgroundColor = '#15803d'}
              onMouseOut={(e) => e.currentTarget.style.backgroundColor = '#16a34a'}
            >
              Download
            </a>
          </div>

          {/* 🌟 INTEGRASI VISUAL BARU: TOMBOL ARSIP DISERAP MASUK MENJADI CO-FOOTER KARTU */}
          <div style="border-top: 1px solid #f1f5f9; padding-top: 12px; margin-top: 2px; text-align: center;">
            <a 
              href="/unduhan" 
              style="text-decoration: none; color: #2563eb; font-size: 0.75rem; font-weight: 700; display: inline-flex; align-items: center; gap: 4px; transition: color 0.15s;"
              onMouseOver={(e) => e.currentTarget.style.color = '#1d4ed8'}
              onMouseOut={(e) => e.currentTarget.style.color = '#2563eb'}
            >
              🗂️ Lihat Seluruh Arsip Brosur Terdahulu ➔
            </a>
          </div>

        </div>



{/* 🌟 INTELLIGENT CLIENT-SIDE ROUTER SWITCH (PRO-LEVEL INTERACTION) */}
<script is:inline>
  function switchBrosurDepan(tipe) {
    const imgDisplay = document.getElementById('img-brosur-display');
    const textLabel = document.getElementById('text-brosur-label');
    const linkDownload = document.getElementById('link-download-brosur');
    const listTabs = ['Utama', 'Biaya', 'Beasiswa'];
    
    // 1. Mutasikan Efek Visual Active State Tab Mini
    listTabs.forEach((tab) => {
      const btn = document.getElementById('tab-brosur-' + tab);
      if (btn) {
        if (tab === tipe) {
          btn.style.backgroundColor = '#0f172a';
          btn.style.color = 'white';
          btn.style.fontWeight = '700';
        } else {
          btn.style.backgroundColor = 'transparent';
          btn.style.color = '#475569';
          btn.style.fontWeight = '600';
        }
      }
    });

    // 2. Jalur Intersepsi Pemindahan Gambar secara Real-time
    if (tipe === 'Utama') {
      imgDisplay.src = "/images/brosur-pmb2026.webp"; // Masukkan fallback atau variabel asli Abang
      textLabel.innerText = "Brosur Utama Pendaftaran Mahasiswa Baru 2026/2027";
      linkDownload.href = "/images/brosur-pmb2026.webp";
    } else if (tipe === 'Biaya') {
      imgDisplay.src = "/images/rincian-biaya-fallback.webp"; // Jalur ban serep jika data kosong
      textLabel.innerText = "Brosur Informasi Rincian Skema Biaya Perkuliahan Kampus";
      linkDownload.href = "/images/rincian-biaya-fallback.webp";
    } else if (tipe === 'Beasiswa') {
      imgDisplay.src = "/images/beasiswa-fallback.webp";
      textLabel.innerText = "Brosur Program Beasiswa Tahfidz & KIP Kuliah STIT YA'MAL";
      linkDownload.href = "/images/beasiswa-fallback.webp";
    }
  }
</script>



