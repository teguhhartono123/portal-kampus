  </div>

  <!-- UX MICRO-COPY: Mengurangi kebingungan user & mencegah chat ganda -->
  <p style="margin: 0; text-align: center; color: #166534; font-size: 0.78rem; font-weight: 500; opacity: 0.8; letter-spacing: 0.1px;">
