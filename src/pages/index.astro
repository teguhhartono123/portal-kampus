              <span style="font-size: 0.75rem; color: #0f766e; background-color: #ccfbf1; padding: 4px 8px; border-radius: 6px; font-weight: bold; border: 1px solid #99f6e4; text-transform: uppercase; display: inline-block; margin-bottom: 8px;">
                {artikel.tipe}
              </span>
              
              <a href={`/baca?id=${artikel.id}`} style="text-decoration: none; display: block;">
                <h3 style="margin: 0 0 6px 0; font-size: 1.15rem; color: #1e293b; font-weight: 700; line-height: 1.4; transition: color 0.15s;" onmouseover="this.style.color='#0d9488'" onmouseout="this.style.color='#1e293b'">
                  {artikel.judul} ➔
                </h3>
              </a>

              <!-- PREVIEW SNIPPET DESCRIPTION -->
              <p style="margin: 0 0 12px 0; font-size: 0.92rem; color: #475569; line-height: 1.5;">
                {artikel.isi ? (artikel.isi.length > 120 ? `${artikel.isi.substring(0, 120)}...` : artikel.isi) : "Silakan klik judul untuk membaca rincian lengkap pengumuman ini."}
              </p>

              <p style="margin: 0; font-size: 0.85rem; color: #64748b;">
                Diterbitkan: {artikel.tanggal}
              </p>
            </div>
          ))}
        </div>

        <!-- 🔢 INTERACTIVE PAGINATION GRID CONTROL BAR -->
        {totalPages > 1 && (
          <div style="display: flex; align-items: center; gap: 6px; margin-top: 8px; padding-left: 4px;">
            {Array.from({ length: totalPages }).map((_, index) => {
              const pageNum = index + 1;
              const isCurrent = currentPage === pageNum;
              return (
                <a 
                  href={pageNum === 1 ? '/' : `/?page=${pageNum}`}
                  style={`text-decoration: none; font-size: 0.85rem; min-width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 8px; font-weight: 700; transition: all 0.15s;
                    border: 1px solid ${isCurrent ? '#0f172a' : '#e2e8f0'};
                    background-color: ${isCurrent ? '#0f172a' : '#ffffff'};
                    color: ${isCurrent ? '#ffffff' : '#475569'};`}
                >
                  {pageNum}
                </a>
              );
            })}
          </div>
        )}

      </div>


        {/* ========================================================================= */}
        {/* 👑 RE-DESIGNED BROCHURE CARD: DUAL ACTION + ARCHIVE INTEGRATION (UX SOLID) */}
        {/* ========================================================================= */}
        <div style="background-color: #ffffff; border: 1px solid #e2e8f0; padding: 24px; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03); max-width: 340px; display: flex; flex-direction: column; gap: 14px;">
          
          {/* Portrait Image Canvas */}
