---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { env } from 'cloudflare:workers';

interface InfoKampus {
  id: number;
  judul: string;
  tanggal: string;
  tipe: string;
  isi: string;
}

// 1. SETUP PAGINATION VARIABLES
const ITEMS_PER_PAGE = 3; 
const url = new URL(Astro.request.url);
const currentPage = parseInt(url.searchParams.get('page') || '1', 10);
const offset = (currentPage - 1) * ITEMS_PER_PAGE;

let daftarPengumuman: InfoKampus[] = [];
let totalPages = 1;
let pesanError = "";
// 🌟 JARING PENYELAMAT VARIABEL UTAS (TARUH DI AREA DEKLARASI PALING ATAS INDEX.ASTRO):
let infoBrosur = null;

try {
  const db = env.database_campuses || env.database_kampus;

  // 🟢 SENSOR INDEX DEPAN: Ambil murni 1 berkas brosur paling gres/terbaru dari database!
  const queryBrosur = await db.prepare("SELECT * FROM konfigurasi_brosur ORDER BY id DESC LIMIT 1;").first();
  infoBrosur = queryBrosur || null;


  if (!db) {
    throw new Error("Database connection 'database_kampus' not found.");
  }

  // 2. GET TOTAL COUNT FOR PAGES
  const countResult = await db.prepare("SELECT COUNT(*) as total FROM daftar_pengumuman").first();
  const totalItems = (countResult?.total as number) || 0;
  totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE);

  // 3. EXECUTE TARGETED SQL QUERY
  const queryResult = await db.prepare(
    "SELECT * FROM daftar_pengumuman ORDER BY id DESC LIMIT ? OFFSET ?"
  ).bind(ITEMS_PER_PAGE, offset).all();
  
  daftarPengumuman = queryResult.results as unknown as InfoKampus[];

} catch (error: any) {
  pesanError = `Gagal memuat data: ${error.message}`;
  console.error(pesanError);
  
  daftarPengumuman = [
    { id: 1, judul: "Pendaftaran Mahasiswa Baru STIT YA'MAL 2026/2027 Telah Dibuka!", tanggal: "05 Juni 2026", tipe: "Akademik", isi: "Silakan hubungi bagian sekretariat kampus resmi." }
  ];
}
---

<Layout title="Portal Resmi - STIT YA'MAL Tangerang">
