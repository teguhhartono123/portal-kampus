---
// src/components/Footer.astro
// Sasis Footer Kampus STIT YA'MAL - 100% Akurat, Navigatif, & Kebal Nyasar!
---
<!-- GANTI LINE PERTAMA TAG <footer> DI FILE Footer.astro MENJADI SEPERTI INI, CHIEF! -->
  <footer style="margin-top: 80px; background-color: #0f172a; color: #94a3b8; padding: 48px 24px; font-family: sans-serif; border-top: 1px solid #1e293b;">
  <div style="max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 40px;">
    
    <!-- KOLOM 1: IDENTITAS KAMPUS -->
    <div style="display: flex; flex-direction: column; gap: 12px;">
      <h3 style="color: #ffffff; font-size: 1.15rem; font-weight: 800; margin: 0; letter-spacing: -0.3px;">
        STIT YA'MAL TANGERANG
      </h3>
      <p style="color: #64748b; font-size: 0.88rem; line-height: 1.6; margin: 0; font-weight: 400;">
        Sekolah Tinggi Ilmu Tarbiyah (STIT) YA'MAL Tangerang. Menyelenggarakan Pendidikan Tinggi Islam Terpadu, Unggul, berintegritas, dan berkarakter mulia.
      </p>
    </div>

    <!-- KOLOM 2: LOKASI KAMPUS + TOMBOL NAVIGASI INTERAKTIF MAPS -->
    <div style="display: flex; flex-direction: column; gap: 12px;">
      <h3 style="color: #ffffff; font-size: 1.15rem; font-weight: 800; margin: 0; letter-spacing: -0.3px;">
        📍 LOKASI KAMPUS
      </h3>
      <p style="color: #cbd5e1; font-size: 0.88rem; line-height: 1.6; margin: 0; font-weight: 500;">
        Kampus Perintis, Jl. Raya Kutabumi, Desa Karet, Kecamatan Sepatan, Kabupaten Tangerang 15520
      </p>
      <!-- 🗺️ JANGKAR PETUNJUK JALAN RAYA (KEBAL NYASAR WAL'AFIAT) -->
      <div style="margin-top: 4px;">
        <a 
          href="https://www.google.com/maps/place/STIT+Ya'mal+Tangerang/@-6.1536514,106.588053,19z/data=!4m10!1m2!2m1!1sstityamal.ac.id!3m6!1s0x2e69ff00506794f7:0xa7be9ecddb76ab60!8m2!3d-6.1536609!4d106.588693!15sCg9zdGl0eWFtYWwuYWMuaWRaESIPc3RpdHlhbWFsIGFjIGlkkgEHY29sbGVnZZoBI0NoWkRTVWhOTUc5blMwVkpRMEZuU1VRM2VVOURlRk5CRUFF4AEA-gEFCIYBEBE!16s%2Fg%2F11w9ybbzrz?entry=ttu&g_ep=EgoyMDI2MDYxMy4wIKXMDSoASAFQAw%3D%3D" 
          target="_blank" 
          rel="noopener noreferrer"
          style="text-decoration: none; font-size: 0.78rem; font-weight: 700; color: #38bdf8; display: inline-flex; align-items: center; gap: 6px; transition: color 0.15s;"
          onmouseover="this.style.color='#7dd3fc'"
          onmouseout="this.style.color='#38bdf8'"
        >
          🌐 Buka Rute di Google Maps (Anti Nyasar) ➔
        </a>
      </div>
    </div>

    <!-- KOLOM 3: KONTAK & LAYANAN INFORMASI -->
    <div style="display: flex; flex-direction: column; gap: 12px;">
      <h3 style="color: #ffffff; font-size: 1.15rem; font-weight: 800; margin: 0; letter-spacing: -0.3px;">
        Hubungi Kami
      </h3>
      <div style="color: #64748b; font-size: 0.88rem; display: flex; flex-direction: column; gap: 6px; font-weight: 500;">
        <p style="margin: 0; color: #94a3b8;">🟢 Helpdesk 1 : <span style="color: #ffffff;">0831-5074-6849</span></p>
        <p style="margin: 0; color: #94a3b8;">🟢 Helpdesk 2 : <span style="color: #ffffff;">0896-9366-6840</span></p>
        <p style="margin: 0; padding-top: 4px; color: #94a3b8;">
          🌐 Situs Resmi : <a href="https://stityamal.ac.id" target="_blank" rel="noopener noreferrer" style="color: #ffffff; text-decoration: underline; font-weight: bold; transition: color 0.15s;" onmouseover="this.style.color='#38bdf8'" onmouseout="this.style.color='#ffffff'">www.stityamal.ac.id</a>
        </p>
      </div>
    </div>

  </div>
  
  <!-- COPYRIGHT BAR -->
  <div style="max-width: 1100px; margin: 40px auto 0 auto; padding-top: 24px; border-top: 1px solid #1e293b; text-align: center; color: #475569; font-size: 0.8rem; font-weight: 600;">
    Copyright © 2026 STIT YA'MAL Tangerang. All rights reserved.
  </div>
</footer>
